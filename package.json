{
  "name": "nexxo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "web",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"npm run dev -w server\" \"npm run dev -w web\"",
    "build": "npm run build -w web",
    "start": "npm run start -w server",
    "test": "node --test \"shared/**/*.test.ts\" \"server/src/**/*.test.ts\"",
    "typecheck": "npm run typecheck -w server && npm run build -w web",
    "lint": "npm run lint -w web"
  },
  "devDependencies": {
    "concurrently": "^9.2.0"
  }
}
